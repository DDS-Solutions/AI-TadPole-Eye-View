{
  "name": "gev-v2-monorepo",
  "version": "1.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "turbo run build",
    "lint": "biome check .",
    "format": "biome format --write .",
    "typecheck": "turbo run typecheck",
    "test": "pnpm test:unit && pnpm test:performance",
    "test:unit": "turbo run test",
    "test:performance": "pnpm --filter @gev/server test:load && pnpm --filter @gev/cesium-kit test:performance",
    "docs:check": "node scripts/adg.mjs",
    "docs:test": "node --test --test-isolation=none scripts/adg.test.mjs",
    "architecture:check": "node scripts/architectural-drift.mjs",
    "docs:providers": "pnpm --filter @gev/contracts build && pnpm --filter @gev/providers build && node scripts/generate-provider-registry.mjs",
    "check:budgets": "node scripts/check-bundle-budgets.mjs",
    "e2e": "turbo run build && pnpm --filter @gev/e2e test:e2e",
    "dev": "turbo run dev",
    "gev": "node packages/cli/dist/index.js"
  },
  "devDependencies": {
    "@biomejs/biome": "1.9.4",
    "@playwright/test": "^1.50.1",
    "@types/node": "^24.1.0",
    "fast-check": "^3.23.2",
    "turbo": "^2.4.4",
    "typescript": "^5.8.2",
    "vitest": "^3.0.7"
  },
  "packageManager": "pnpm@10.34.5",
  "engines": {
    "node": ">=24"
  }
}
