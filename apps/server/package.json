{
  "name": "@gev/server",
  "version": "0.1.0",
  "type": "module",
  "main": "./dist/index.js",
  "scripts": {
    "dev": "node --import tsx --watch src/index.ts",
    "build": "tsc",
    "typecheck": "tsc --noEmit",
    "test": "vitest run --exclude test/load.test.ts --exclude test/tadpoleM1M4Performance.test.ts",
    "test:load": "vitest run test/load.test.ts --no-file-parallelism --maxWorkers=1",
    "test:performance": "vitest run test/tadpoleM1M4Performance.test.ts --no-file-parallelism --maxWorkers=1",
    "start": "node dist/index.js",
    "lint": "biome check ."
  },
  "dependencies": {
    "@gev/contracts": "workspace:*",
    "@gev/core": "workspace:*",
    "@gev/economic": "workspace:*",
    "@gev/governance": "workspace:*",
    "@gev/ops-mcp": "workspace:*",
    "@gev/providers": "workspace:*",
    "@gev/security": "workspace:*",
    "@hono/node-server": "^2.1.8",
    "@modelcontextprotocol/hono": "2.0.2",
    "hono": "^4.13.18",
    "jose": "^6.2.17",
    "ws": "^8.22.2"
  },
  "devDependencies": {
    "@types/node": "^24.19.2",
    "@types/ws": "^8.18.2",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vitest": "^5.1.0"
  }
}
