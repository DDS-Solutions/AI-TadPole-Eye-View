{
  "name": "@gev/governance",
  "version": "0.1.0",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsc",
    "typecheck": "tsc --noEmit",
    "test": "vitest run --exclude test/agentEnvelopePerformance.test.ts",
    "test:performance": "vitest run test/agentEnvelopePerformance.test.ts --no-file-parallelism --maxWorkers=1",
    "lint": "biome check ."
  },
  "dependencies": {
    "@gev/contracts": "workspace:*",
    "@gev/core": "workspace:*"
  },
  "devDependencies": {
    "@types/node": "^24.19.2",
    "fast-check": "^4.10.2",
    "typescript": "^7.0.2",
    "vitest": "^5.1.0"
  }
}
