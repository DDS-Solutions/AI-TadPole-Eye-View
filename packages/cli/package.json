  },
  "dependencies": {
    "@gev/contracts": "workspace:*",
    "@gev/core": "workspace:*",
    "@gev/governance": "workspace:*",
    "@gev/ops-mcp": "workspace:*",
    "@gev/providers": "workspace:*",
    "@gev/security": "workspace:*",
    "commander": "^13.1.0",
    "picocolors": "^1.1.1",
    "zod": "^3.24.2"
  },
  "devDependencies": {
    "@types/node": "^24.1.0",
    "typescript": "^5.9.3",
    "vitest": "^3.2.7"
  }
}
