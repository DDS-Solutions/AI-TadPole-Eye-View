    "lint": "biome check ."
  },
  "dependencies": {
    "@gev/contracts": "workspace:*",
    "@gev/core": "workspace:*",
    "@gev/security": "workspace:*",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "typescript": "^7.0.2",
    "vitest": "^5.0.0"
  }
}
