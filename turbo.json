{
  "$schema": "https://turbo.build/schema.json",
  "globalEnv": ["GEV_SEED_MODE", "GEV_LIVE_MODE", "GEV_APPROVAL_POLICY", "NODE_ENV", "TZ"],
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "outputs": ["dist/**"]
    },
    "lint": {
      "dependsOn": ["^build"]
    },
    "typecheck": {
      "dependsOn": ["^build"]
    },
    "test": {
      "dependsOn": ["^build"]
    },
    "dev": {
      "cache": false,
      "persistent": true
    }
  }
}
